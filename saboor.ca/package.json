{
  "name": "saboor-ca",
  "homepage": "https://saboor.ca",
  "description": "sab's portfolio",
  "engines": {
    "node": ">=23.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "author": "saboooor",
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "vp lint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vp preview",
    "serve": "wrangler dev",
    "start": "vp dev --mode ssr --host",
    "start.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --forcenode --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "qwik": "qwik"
  },
  "sideEffects": false,
  "devDependencies": {
    "@luminescent/icons-qwik": "0.1.1",
    "@luminescent/ui": "^7.0.2",
    "@luminescent/ui-qwik": "7.0.0-20",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@8785",
    "@qwik.dev/router": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/router@8785",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "eslint-plugin-qwik": "2.0.0-beta.35",
    "globals": "^17.7.0",
    "lucide-icons-qwik": "1.24.0-qwik-v2",
    "oxlint-plugin-qwik": "^0.0.9",
    "playwright": "^1.61.1",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "6",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.7.0",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.112.0",
    "vite-plus": "catalog:"
  }
}
