{
  "name": "saboor-ca",
  "homepage": "https://saboor.ca",
  "description": "sab's portfolio",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.5",
      "onFail": "download"
    }
  },
  "type": "module",
  "author": "saboooor",
  "scripts": {
    "build": "vp run cf-typegen && qwik build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "vp lint",
    "preview": "qwik build preview && vp preview",
    "serve": "wrangler dev",
    "start": "vp dev --mode ssr --host",
    "start.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --forcenode --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "qwik": "qwik",
    "drizzle:check": "drizzle-kit check",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "wrangler:migrate-local": "wrangler d1 migrations apply music"
  },
  "sideEffects": false,
  "devDependencies": {
    "@luminescent/icons-qwik": "0.1.2",
    "@luminescent/ui": "^7.2.0",
    "@luminescent/ui-qwik": "7.0.0",
    "@qwik.dev/core": "^2.0.0-rc.0",
    "@qwik.dev/router": "^2.0.0-rc.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "globals": "^17.13.0",
    "lucide-icons-qwik": "1.24.0-qwik-v2",
    "oxlint-plugin-qwik": "^0.0.9",
    "playwright": "^1.63.0",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7",
    "undici": "^8.11.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.147.0"
  }
}
